# MendiCot Version 2 Frontend Environment Configuration
#
# IMPORTANT: All VITE_* environment variables are PUBLIC and will be bundled
# into client-side JavaScript by Vite during build. Do NOT store private API keys,
# database credentials, or secret tokens here.

# Base URL of the FastAPI backend (HTTPS in production, HTTP in local development)
VITE_API_BASE_URL=http://127.0.0.1:8000
